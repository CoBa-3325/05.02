<Window x:Class="TourAgency.TourWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Тур" Height="700" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Название" />
            <TextBox x:Name="txtName" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Страна" />
            <ComboBox x:Name="cmbCountry" SelectionChanged="Country_Changed" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="Город" />
            <ComboBox x:Name="cmbCity" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="Дата начала" />
            <DatePicker x:Name="dpStart" />
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,8">
            <TextBlock Text="Дата окончания" />
            <DatePicker x:Name="dpEnd" />
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,0,0,8">
            <TextBlock Text="Стоимость, ₽" />
            <TextBox x:Name="txtPrice" />
        </StackPanel>

        <StackPanel Grid.Row="6" Margin="0,0,0,8">
            <TextBlock Text="Количество мест" />
            <TextBox x:Name="txtSeats" />
        </StackPanel>

        <StackPanel Grid.Row="7" Margin="0,0,0,8">
            <TextBlock Text="Фотография" />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnPhoto" Content="Выбрать фото..." Click="Photo_Click" Padding="10,4" Margin="0,0,10,0" />
                <Button x:Name="btnPickPhoto" Content="Из загруженных" Click="PickPhoto_Click" Padding="10,4" Margin="0,0,10,0" />
                <Button x:Name="btnRemovePhoto" Content="Убрать" Click="RemovePhoto_Click" Padding="10,4" />
            </StackPanel>
            <Image x:Name="imgPreview" Width="180" Height="100" Stretch="UniformToFill"
                   Margin="0,8,0,0" HorizontalAlignment="Left" />
            <TextBlock x:Name="lblPhoto" FontSize="11" Foreground="Gray" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Width="110" Margin="0,0,8,0" Click="Save_Click" />
            <Button Content="Отмена" Width="90" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
