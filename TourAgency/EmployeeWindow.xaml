<Window x:Class="TourAgency.EmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пользователь" Height="400" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="ФИО" />
            <TextBox x:Name="txtFio" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Должность" />
            <ComboBox x:Name="cmbDolzhnost" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="Телефон" />
            <TextBox x:Name="txtPhone" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="Роль" />
            <ComboBox x:Name="cmbRol" />
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,8">
            <TextBlock Text="Логин" />
            <TextBox x:Name="txtLogin" />
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,0,0,8">
            <TextBlock x:Name="lblPassword" Text="Пароль" />
            <PasswordBox x:Name="txtPassword" />
        </StackPanel>

        <StackPanel Grid.Row="6" x:Name="panelClient" Margin="0,0,0,8" Visibility="Collapsed">
            <TextBlock Text="Клиент (для роли «Клиент»)" />
            <ComboBox x:Name="cmbKlient" />
        </StackPanel>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Width="110" Margin="0,0,8,0" Click="Save_Click" />
            <Button Content="Отмена" Width="90" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
